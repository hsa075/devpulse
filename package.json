{
  "name": "devpulse",
  "version": "0.1.0",
  "description": "A lightweight, open-source HTTP endpoint health checker and JSON reporter.",
  "type": "module",
  "bin": {
    "devpulse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "api",
    "healthcheck",
    "monitoring",
    "http",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
